{
  "$schema": "https://turbo.build/schema.json",
  // Turborepo filtra las env vars que no estén acá, aunque el proceso que
  // lo invoca (CI, Vercel) sí las tenga seteadas — sin esto, tareas como
  // "prisma generate" (apps/api) no ven DATABASE_URL y fallan aunque el
  // valor exista en el entorno real.
  "globalEnv": [
    "DATABASE_URL",
    "PORT",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "OPENWEATHER_API_KEY",
    "OPENWEATHER_BASE_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_AUTH_MOCK"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      // src/generated/prisma/** (apps/api): salida de "prisma generate",
      // que corre como parte de este mismo task. Sin declararla acá, un
      // "cache hit" de Turbo repite el LOG de una corrida vieja sin volver
      // a generar los archivos reales (quedan ausentes en el checkout).
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/generated/prisma/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build"]
    }
  }
}