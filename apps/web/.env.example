# URL base de apps/api (NestJS). Por defecto http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mientras el subagente BE no exponga POST /auth/login, activá el mock:
# el login devuelve un JWT falso (rol según el email: "admin" → ADMIN, si no AGRICULTOR).
# Post server actions request — una vez vivo POST /auth/login en apps/api, setear en "false".
NEXT_PUBLIC_AUTH_MOCK=true