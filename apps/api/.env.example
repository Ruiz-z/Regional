# Copiar a .env y ajustar según entorno. Ninguna credencial se commitea (constitution.md #15).
DATABASE_URL="postgresql://smartriego:smartriego@localhost:5432/smartriego_test"
PORT=3000
JWT_SECRET="cambiar-en-produccion"
# Expiración del token en segundos (86400 = 24 h, ver spec-001 RF-4)
JWT_EXPIRES_IN=86400
# Pronóstico de lluvia para el motor de riego (spec-004 RF-2). Sin key, el
# sistema decide solo con humedad+modelo (casos límite de la spec).
OPENWEATHER_API_KEY=""
OPENWEATHER_BASE_URL="https://api.openweathermap.org/data/2.5/weather"
# Emails transaccionales/críticos vía Resend (spec-006). Sin key, se loguea
# y no bloquea el resto del flujo (push/dashboard ya se enviaron igual).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SmartRiego MX <notificaciones@smartriego.mx>"