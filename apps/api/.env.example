# Copiar a .env y ajustar según entorno. Ninguna credencial se commitea (constitution.md #15).
DATABASE_URL="postgresql://smartriego:smartriego@localhost:5432/smartriego_test"
PORT=3000
JWT_SECRET="cambiar-en-produccion"
# Expiración del token en segundos (86400 = 24 h, ver spec-001 RF-4)
JWT_EXPIRES_IN=86400
# Pronóstico de lluvia para el motor de riego (spec-004 RF-2), vía Open-Meteo
# (gratuito, sin API key). Opcional: solo sobreescribir para testing/mocking.
# OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"
# OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
# Emails transaccionales/críticos vía Resend (spec-006). Sin key, se loguea
# y no bloquea el resto del flujo (push/dashboard ya se enviaron igual).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SmartRiego MX <notificaciones@smartriego.mx>"
# Autentica el Vercel Cron Job del resumen semanal (ver CronSecretGuard).
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# Botón "Llamar dron" (POST /zones/:id/call-drone) -> apps/vision /detect.
VISION_SERVICE_URL="http://localhost:8001"
VISION_INTERNAL_SECRET=""