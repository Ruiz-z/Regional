# Copiar a .env y ajustar según entorno. Ninguna credencial se commitea (constitution.md #15).
API_BASE_URL="http://localhost:4000"
# API key de dispositivo generada por POST /devices (type=VISION_SERVICE) en el backend.
DEVICE_API_KEY=""
# Grid de cuadrantes fijos que coincide con las zonas físicas de la maqueta
# (spec-005, casos límite: sin calibración manual). Formato: {"fila,col": "zoneId"}.
# Para una sola zona (una cámara/una maqueta, un solo cultivo): GRID_ROWS=1,
# GRID_COLS=1, ZONE_MAP={"0,0":"<zoneId real>"} — así cualquier punto del
# frame cae siempre en esa única zona.
ZONE_MAP='{"0,0":"","0,1":""}'
GRID_ROWS=2
GRID_COLS=2
FRAME_WIDTH=640
FRAME_HEIGHT=480
CONFIDENCE_THRESHOLD=0.5
CAPTURE_INTERVAL_SECONDS=5
# "classifier" (Teachable Machine, app/models/pest_classifier.tflite — el
# modelo entrenado real que tenemos hoy) o "yolo" (detector por cajas, para
# cuando exista un modelo YOLO propio entrenado con el dataset de la plaga).
MODEL_BACKEND=classifier
CLASSIFIER_MODEL_PATH="app/models/pest_classifier.tflite"
CLASSIFIER_LABELS_PATH="app/models/labels.txt"
YOLO_WEIGHTS_PATH="yolo11n.pt"

# Botón "Llamar dron" (POST /detect, backend -> acá). Sin valor, rechaza
# siempre. Generar con: openssl rand -hex 32
VISION_INTERNAL_SECRET=""
# Cámara USB para detección puntual, distinta de la cámara 0 (loop continuo).
ON_DEMAND_CAMERA_INDEX=1
