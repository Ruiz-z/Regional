# Copiar a .env y ajustar según entorno. Ninguna credencial se commitea (constitution.md #15).
API_BASE_URL="http://localhost:4000"
# API key de dispositivo generada por POST /devices (type=VISION_SERVICE) en el backend.
DEVICE_API_KEY=""
# Grid de cuadrantes fijos que coincide con las zonas físicas de la maqueta
# (spec-005, casos límite: sin calibración manual). Formato: {"fila,col": "zoneId"}.
ZONE_MAP='{"0,0":"","0,1":""}'
GRID_ROWS=2
GRID_COLS=2
FRAME_WIDTH=640
FRAME_HEIGHT=480
CONFIDENCE_THRESHOLD=0.5
CAPTURE_INTERVAL_SECONDS=5
YOLO_WEIGHTS_PATH="yolo11n.pt"
